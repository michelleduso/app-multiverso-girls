# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.

# Público — expostos ao browser (Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Apenas servidor — NUNCA prefixar com NEXT_PUBLIC_, nunca importar em Client Components.
# Usada somente em rotinas administrativas server-side (ex.: ações de moderação).
SUPABASE_SERVICE_ROLE_KEY=
